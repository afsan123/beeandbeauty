# =============================================================================
# Bee & Beauty Bangladesh — Environment Variables Reference
# Target Market: Bangladesh (Currency: BDT / ৳)
# Copy to Vercel → Project Settings → Environment Variables.
# The live Hobby project currently has ZERO env vars — set these before go-live.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Site Metadata & Canonical Domain
# -----------------------------------------------------------------------------
# Public. Production / Preview / Development.
NEXT_PUBLIC_SITE_URL=https://beeandbeauty.vercel.app

# -----------------------------------------------------------------------------
# 2. Supabase (required for catalog writes, orders, customer auth, storage)
# -----------------------------------------------------------------------------
# Public. Production / Preview / Development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon / publishable key. NEVER put the service role here.
# Production / Preview / Development.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional newer publishable key (used if ANON_KEY is unset). Public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SENSITIVE. Server-only. Production / Preview / Development.
# Required at runtime for orders, admin uploads, and customer provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional alias for the service role. SENSITIVE. Same targets.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# -----------------------------------------------------------------------------
# 3. Executive Admin (HMAC session — separate from customer Supabase Auth)
# -----------------------------------------------------------------------------
# SENSITIVE. Production / Preview / Development.
ADMIN_EMAIL=admin@beeandbeauty.bd
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-64-character-random-secret

# Optional second executive. SENSITIVE. Same targets.
ADMIN_MANAGER_EMAIL=manager@beeandbeauty.bd
ADMIN_MANAGER_PASSWORD=replace-with-a-long-random-password

# -----------------------------------------------------------------------------
# 4. Transactional email (optional — without this we do not claim email was sent)
# -----------------------------------------------------------------------------
# SENSITIVE. Production / Preview.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Bee & Beauty <beeandbeauty.bd@gmail.com>

# -----------------------------------------------------------------------------
# 5. Public brand / logistics (safe to expose)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801754502430
NEXT_PUBLIC_OFFICIAL_EMAIL=beeandbeauty.bd@gmail.com
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=2500
NEXT_PUBLIC_DHAKA_SHIPPING_FEE=70
NEXT_PUBLIC_OUTSIDE_DHAKA_SHIPPING_FEE=130
