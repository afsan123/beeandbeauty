# =============================================================================
# Bee & Beauty Bangladesh — Environment Variables Reference
# Target Market: Bangladesh (Currency: BDT / ৳)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Site Metadata & Canonical Domain (Vercel Production)
# -----------------------------------------------------------------------------
# Used for OpenGraph metadata, sitemap.xml canonical URLs, and robots.txt
NEXT_PUBLIC_SITE_URL=https://beeandbeauty.bd

# -----------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database & Realtime Configuration
# -----------------------------------------------------------------------------
# The URL of your Supabase project instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client-side queries and Realtime WebSocket subscriptions
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role secret key (NEVER expose to client; used strictly in server routes and proxy)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Supabase CLI / Secret access keys
SUPABASE_SECRET_KEY=your-supabase-secret-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# -----------------------------------------------------------------------------
# 3. Executive Back-Office Authentication (Route: /admin/login)
# -----------------------------------------------------------------------------
# Canonical email for Executive Admin login
ADMIN_EMAIL=admin@beeandbeauty.bd

# Strong password for Executive Admin back-office access
ADMIN_PASSWORD=your-secure-admin-password

# High-entropy HMAC-SHA256 secret key for tamper-proof session tokens
ADMIN_SESSION_SECRET=your-random-64-character-session-secret-key

# -----------------------------------------------------------------------------
# 4. Logistics, Courier SLAs & Customer Contact Channels
# -----------------------------------------------------------------------------
# Official WhatsApp support concierge number (format: +8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801754502430

# Official brand contact email
NEXT_PUBLIC_OFFICIAL_EMAIL=beeandbeauty.bd@gmail.com

# Free shipping cart subtotal threshold in BDT (Default: ৳2,500 nationwide)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=2500

# Courier fee inside Dhaka metropolitan zone in BDT (Default: ৳70, Target SLA: 24h)
NEXT_PUBLIC_DHAKA_SHIPPING_FEE=70

# Courier fee outside Dhaka across all 64 districts in BDT (Default: ৳130, Target SLA: 48h)
NEXT_PUBLIC_OUTSIDE_DHAKA_SHIPPING_FEE=130
